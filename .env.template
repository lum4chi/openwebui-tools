# youtube_manager live harness — duplicate to .env, fill in, NEVER commit .env
# Production topology: STALE = token currently in the OWUI valve google_refresh_token (pre-reauth);
# FRESH = token stored after re-auth (<OWUI data dir>/data/<user_id>/google-refresh-token.md)
YTM_GOOGLE_CLIENT_ID=
YTM_GOOGLE_CLIENT_SECRET=
YTM_GOOGLE_REFRESH_TOKEN_STALE=
YTM_GOOGLE_REFRESH_TOKEN_FRESH=
# Open WebUI user id (sanitized) the OWUI instance injects as __user__
YTM_USER_ID=
# Optional overrides (defaults shown)
YTM_DATA_DIR=.data-live
YTM_VERBOSE=false
YTM_DIGEST_PLAYLIST_TITLE=Open WebUI Digest
YTM_DIGEST_MAX_ITEMS=50
YTM_DIGEST_MAX_AGE_DAYS=30
