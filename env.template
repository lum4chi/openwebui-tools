# youtube_manager live harness — duplicate to .env, fill in, NEVER commit .env
# INITIAL condition only: client id/secret + OWUI user id. NO refresh token — on first run the
# harness performs ONE browser auth (start_auth → it prints the consent URL → you paste the
# redirected URL or bare code → finish_auth) and the token lands in <YTM_DATA_DIR>/<user_id>/
# google-refresh-token.md automatically. Re-runs reuse the token file (no browser).
YTM_GOOGLE_CLIENT_ID=
YTM_GOOGLE_CLIENT_SECRET=
# Open WebUI user id (sanitized) the OWUI instance injects as __user__
YTM_USER_ID=
# Optional override (default shown)
YTM_DATA_DIR=.data-live
